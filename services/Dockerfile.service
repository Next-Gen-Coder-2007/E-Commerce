# ==========================================
# Parameterized Microservice Multi-Stage Dockerfile
# Usage: docker build --build-arg SERVICE_NAME=order-service -f Dockerfile.service -t order-service:latest .
# ==========================================
FROM node:20-alpine AS dependencies

WORKDIR /app

# Copy root services package manifests
COPY package*.json ./
RUN npm ci --only=production --prefer-offline --no-audit

# ==========================================
# Runner Stage
# ==========================================
FROM node:20-alpine AS runner

ARG SERVICE_NAME=auth-service
ARG SERVICE_PORT=5001

WORKDIR /app
ENV NODE_ENV=production
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=${SERVICE_PORT}

# Run as non-root user
USER node

# Copy dependencies and shared libs
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node package*.json ./
COPY --chown=node:node shared/ ./shared/
COPY --chown=node:node ${SERVICE_NAME}/ ./${SERVICE_NAME}/

EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:${PORT}/health || exit 1

CMD ["sh", "-c", "node ${SERVICE_NAME}/server.js"]
