{
  "openapi": "3.0.3",
  "info": {
    "title": "NovaCommerce Enterprise Distributed Marketplace API",
    "description": "Production-grade microservices API specification with Saga Distributed Orchestration, Kafka KRaft Event Bus, AI Vector Search, Real-Time Fraud Scoring, and Resilient Circuit Breakers.",
    "version": "1.0.0",
    "contact": {
      "name": "NovaCommerce Architecture Team",
      "email": "architecture@novacommerce.io"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "API Gateway Entrypoint"
    }
  ],
  "tags": [
    { "name": "System & Telemetry", "description": "Cluster Health, Prometheus Metrics, Service Discovery" },
    { "name": "Authentication", "description": "User & Merchant Identity, JWT Tokens, Role Verification, Saved Addresses" },
    { "name": "Products & Discovery", "description": "Product Catalog, Specifications, Faceted Filter Search, Dynamic Categories" },
    { "name": "Customer Reviews", "description": "Verified Customer Reviews, Rating Distributions, Merchant Official Replies" },
    { "name": "Promotional Coupons", "description": "Promo Codes, Store Campaigns, Multi-Tier Discount Validation" },
    { "name": "AI Search & Recommendations", "description": "64-dim Dense Vector Embeddings, RRF Hybrid Search, AI Shopping Concierge" },
    { "name": "Cart", "description": "Shopping Cart Session Management (Redis & DB)" },
    { "name": "Wishlist", "description": "Wishlist Items, Shareable Lists, Price Drop Tracking & Move to Cart" },
    { "name": "Orders & Saga", "description": "Saga Distributed Transaction Orchestration, Compensation, Tracking & Cancellation" },
    { "name": "Payments & Fraud", "description": "Idempotent Payment Processing, Webhooks & Real-Time Fraud Risk Scoring" },
    { "name": "Inventory", "description": "Distributed Two-Phase Stock Reservations, Commitments, Releases & Audits" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System & Telemetry"],
        "summary": "Check API Gateway and registered downstream microservice health status",
        "responses": {
          "200": { "description": "Cluster operational status" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["System & Telemetry"],
        "summary": "Scrape Prometheus telemetry metrics and latency histograms",
        "responses": {
          "200": { "description": "Prometheus text format metric dump" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new Customer or Merchant account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "role": { "type": "string", "enum": ["customer", "company", "admin"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User successfully registered" },
          "400": { "description": "Validation failure or email already in use" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and issue JWT cookie/token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate with Google OAuth ID token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idToken"],
                "properties": {
                  "idToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Google Single Sign-On authenticated" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get authenticated user profile details",
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/auth/business-details": {
      "put": {
        "tags": ["Authentication"],
        "summary": "Update merchant business banking, tax ID, and address",
        "responses": {
          "200": { "description": "Business profile updated" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products & Discovery"],
        "summary": "Get paginated products with filtering and sorting",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "brand", "in": "query", "schema": { "type": "string" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "price_asc", "price_desc", "rating"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 12 } }
        ],
        "responses": {
          "200": { "description": "List of paginated products" }
        }
      },
      "post": {
        "tags": ["Products & Discovery"],
        "summary": "Create new product in catalog (Merchant/Admin only)",
        "responses": {
          "201": { "description": "Product created" }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products & Discovery"],
        "summary": "Get full product details by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product details" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/api/products/categories": {
      "get": {
        "tags": ["Products & Discovery"],
        "summary": "Get dynamic distinct categories with live inventory counts",
        "responses": {
          "200": { "description": "Array of active category strings and aggregate counts" }
        }
      }
    },
    "/api/products/search/semantic": {
      "get": {
        "tags": ["AI Search & Recommendations"],
        "summary": "Hybrid vector + keyword search using Reciprocal Rank Fusion (RRF)",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Hybrid ranked products" }
        }
      }
    },
    "/api/products/recommendations/for-you": {
      "get": {
        "tags": ["AI Search & Recommendations"],
        "summary": "Get personalized multi-signal AI recommendations (Wishlist weighted)",
        "responses": {
          "200": { "description": "Curated recommendations with match justification tags" }
        }
      }
    },
    "/api/products/recommendations/frequently-bought-together/{productId}": {
      "get": {
        "tags": ["AI Search & Recommendations"],
        "summary": "Get bundle recommendations with dynamic bundle savings",
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Complementary bundle items" }
        }
      }
    },
    "/api/products/ai-assistant/chat": {
      "post": {
        "tags": ["AI Search & Recommendations"],
        "summary": "Conversational AI Shopping Concierge with constraint extraction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string" },
                  "history": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Conversational reply with grounded product cards" }
        }
      }
    },
    "/api/reviews/product/{id}": {
      "get": {
        "tags": ["Customer Reviews"],
        "summary": "Get product reviews and rating breakdown",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product customer reviews" }
        }
      },
      "post": {
        "tags": ["Customer Reviews"],
        "summary": "Submit verified purchase customer review with photos",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "Review submitted" }
        }
      }
    },
    "/api/coupons/available": {
      "get": {
        "tags": ["Promotional Coupons"],
        "summary": "List active eligible discount coupons",
        "responses": {
          "200": { "description": "Available coupons" }
        }
      }
    },
    "/api/coupons/validate": {
      "post": {
        "tags": ["Promotional Coupons"],
        "summary": "Validate promo code against cart items and calculate discount",
        "responses": {
          "200": { "description": "Coupon discount breakdown" }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get active user or guest shopping cart",
        "responses": {
          "200": { "description": "Active shopping cart" }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add item or increment quantity in shopping cart",
        "responses": {
          "200": { "description": "Updated cart" }
        }
      }
    },
    "/api/wishlist": {
      "get": {
        "tags": ["Wishlist"],
        "summary": "Fetch customer wishlist items with real-time price change indicators",
        "responses": {
          "200": { "description": "User wishlist" }
        }
      }
    },
    "/api/wishlist/items": {
      "post": {
        "tags": ["Wishlist"],
        "summary": "Add product to customer wishlist",
        "responses": {
          "201": { "description": "Item saved to wishlist" }
        }
      }
    },
    "/api/wishlist/items/{productId}/move-to-cart": {
      "post": {
        "tags": ["Wishlist"],
        "summary": "1-click atomic move from wishlist into active shopping cart",
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Moved to cart successfully" }
        }
      }
    },
    "/api/wishlist/shared/{shareToken}": {
      "get": {
        "tags": ["Wishlist"],
        "summary": "Public read-only access for shared gift registry wishlist",
        "parameters": [
          { "name": "shareToken", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Public wishlist registry" }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": ["Orders & Saga"],
        "summary": "Create order and trigger distributed Saga Orchestrator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items", "shippingAddress", "paymentMethod"],
                "properties": {
                  "items": { "type": "array", "items": { "type": "object" } },
                  "shippingAddress": { "type": "object" },
                  "paymentMethod": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created and Saga dispatched" }
        }
      },
      "get": {
        "tags": ["Orders & Saga"],
        "summary": "Get authenticated customer's order history",
        "responses": {
          "200": { "description": "Customer orders" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Orders & Saga"],
        "summary": "Get order tracking and fulfillment status timeline",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order details & timeline" }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "post": {
        "tags": ["Orders & Saga"],
        "summary": "Cancel order within grace period and trigger automated refund compensation",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order cancelled & refund queued" }
        }
      }
    },
    "/api/payments/charge": {
      "post": {
        "tags": ["Payments & Fraud"],
        "summary": "Idempotent payment processing with card gateway and duplicate protection",
        "parameters": [
          { "name": "x-idempotency-key", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["orderId", "amount"],
                "properties": {
                  "orderId": { "type": "string" },
                  "amount": { "type": "number" },
                  "currency": { "type": "string", "default": "USD" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment succeeded" },
          "402": { "description": "Payment failed / card declined" }
        }
      }
    },
    "/api/payments/fraud/evaluate": {
      "post": {
        "tags": ["Payments & Fraud"],
        "summary": "Real-time 0-100 transaction risk evaluation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "number" },
                  "email": { "type": "string" },
                  "ordersInLastHour": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Risk score, risk level, decision (APPROVE, REVIEW, REJECT)" }
        }
      }
    },
    "/api/inventory/reserve": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Phase 1: Two-phase stock reservation with 15m TTL expiration",
        "responses": {
          "200": { "description": "Stock reserved (Reservation token returned)" },
          "409": { "description": "Insufficient stock" }
        }
      }
    },
    "/api/inventory/commit": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Phase 2: Permanently commit reserved stock deduction",
        "responses": {
          "200": { "description": "Stock permanently committed" }
        }
      }
    },
    "/api/inventory/release": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Compensate: Release reserved stock back into available pool",
        "responses": {
          "200": { "description": "Reserved stock released" }
        }
      }
    },
    "/api/inventory/product/{productId}": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Query real-time stock levels (available, reserved, total)",
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Inventory levels" }
        }
      }
    }
  }
}
