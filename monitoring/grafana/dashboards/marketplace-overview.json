      "title": "Marketplace Service Mesh Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Request Rate (RPS by Service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 Latency Heatmap (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 - {{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "title": "Distributed Transactions & Event Streaming",
      "type": "row"
    },
    {
      "id": 3,
      "title": "Distributed Saga Transactions (Success vs Rollbacks)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum by (status) (rate(saga_transactions_total[1m]))",
          "legendFormat": "Status: {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Event Backbone Throughput (Events/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_messages_produced_total[1m]))",
          "legendFormat": "Produced: {{topic}}",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(kafka_messages_consumed_total[1m]))",
          "legendFormat": "Consumed: {{topic}}",
          "refId": "B"
        }
      ]
    }
  ],
