{
  "name": "e-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node api/index.js",
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --prefix client",
    "gateway": "npm run dev --prefix gateway",
    "auth-service": "npm run dev:auth --prefix services",
    "product-service": "npm run dev:product --prefix services",
    "cart-service": "npm run dev:cart --prefix services",
    "order-service": "npm run dev:order --prefix services",
    "payment-service": "npm run dev:payment --prefix services",
    "wishlist-service": "npm run dev:wishlist --prefix services",
    "inventory-service": "npm run dev:inventory --prefix services",
    "notification-service": "npm run dev:notification --prefix services",
    "kafka:up": "docker compose -f docker-compose.kafka.yml up -d",
    "kafka:down": "docker compose -f docker-compose.kafka.yml down",
    "kafka:init": "npm run kafka:init --prefix services",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "multer": "^2.3.0"
  }
}
