# ==========================================
# NovaCommerce Unified Backend Production Container
# ==========================================
FROM node:20-alpine AS production

WORKDIR /app

# Install curl for healthchecks
RUN apk add --no-cache curl

# Copy root package files
COPY package*.json ./

# Copy Gateway and Services package files for cached dependency layer
COPY gateway/package*.json ./gateway/
COPY services/package*.json ./services/

# Install production dependencies
RUN npm install --omit=dev --prefix gateway && \
    npm install --omit=dev --prefix services

# Copy source code
COPY . .

# Set production environment
ENV NODE_ENV=production
ENV PORT=5000

# Expose default API Gateway port
EXPOSE 5000

# Healthcheck against Gateway /health
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5000}/health || exit 1

# Launch the unified cluster runner
CMD ["node", "start-all.js"]
